<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- A.1: Full console command -->
        <service id="Boxalino\DataIntegrationDoc\Framework\Console\UserSelection\FullDataIntegration">
            <argument type="service" id="Boxalino\DataIntegration\Service\UserSelection\Logger"/>
            <argument type="service" id="Boxalino\DataIntegrationDoc\Framework\Util\DiConfigurationInterface"/>
            <argument type="service" id="Boxalino\DataIntegrationDoc\Service\Integration\UserSelectionIntegrationHandlerInterface"/>
            <tag name="console.command"/>
        </service>

        <!-- A.2: Delta console command -->
        <service id="Boxalino\DataIntegrationDoc\Framework\Console\UserSelection\DeltaDataIntegration">
            <argument type="service" id="Boxalino\DataIntegration\Service\UserSelection\Logger"/>
            <argument type="service" id="Boxalino\DataIntegrationDoc\Framework\Util\DiConfigurationInterface"/>
            <argument type="service" id="Boxalino\DataIntegrationDoc\Service\Integration\UserSelectionDeltaIntegrationHandlerInterface"/>
            <tag name="console.command"/>
        </service>

        <!-- B.1: DI handler - generates each file type (handler) required for FULL data integration -->
        <service id="Boxalino\DataIntegrationDoc\Service\Integration\UserSelectionIntegrationHandlerInterface"
                 class="Boxalino\DataIntegration\Service\Integration\UserSelection\FullIntegrationHandler"
                 parent="boxalino.di.handler.abstract">
            <call method="addHandler">
                <argument type="service" id="Boxalino\DataIntegrationDoc\Service\Integration\Doc\DocUserSelectionHandlerInterface"/>
            </call>
        </service>

        <!-- B.2: DI handler - generates each file type (handler) required for DELTA data integration -->
        <service id="Boxalino\DataIntegrationDoc\Service\Integration\UserSelectionDeltaIntegrationHandlerInterface"
                 class="Boxalino\DataIntegration\Service\Integration\UserSelection\DeltaIntegrationHandler"
                 parent="boxalino.di.handler.abstract">
            <call method="addHandler">
                <argument type="service" id="Boxalino\DataIntegrationDoc\Service\Integration\Doc\DocUserSelectionHandlerInterface"/>
            </call>
        </service>

    </services>

</container>
